# Токен Discord-бота (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_bot_token_here

# ID сервера (гильдии), на котором работает бот
GUILD_ID=123456789012345678

# ID голосового канала для тестов (создай канал сам в Discord,
# включи Developer Mode -> ПКМ по каналу -> Copy Channel ID)
TEST_VOICE_CHANNEL_ID=123456789012345678

# Твой Discord user ID — сюда бот будет слать ЛС с результатами
# (ПКМ по своему нику -> Copy User ID)
OWNER_USER_ID=123456789012345678

# Сколько секунд держать голосовое соединение перед тем как считать
# подключение успешным (проверяем что не отвалилось)
HOLD_SECONDS=5

# Таймаут на сам connect() к голосовому каналу
CONNECT_TIMEOUT=15

# Пауза между стратегиями в /voice_test_all, секунды
STRATEGY_SWITCH_DELAY=5

# Автоматический периодический прогон ВСЕХ стратегий без ручной команды
# (та же логика, что /voice_rank) -- 0 отключает полностью. Отчёт уходит
# владельцу (OWNER_USER_ID) в ЛС тем же способом, что и у ручных команд.
AUTO_CHECK_INTERVAL_HOURS=6
AUTO_CHECK_PASSES=1

# Тестирование теперь идёт через песочницу Zenith (см. README) -- не
# через боевой locked.tsv. Обычно менять не нужно, дефолты рассчитаны на
# стандартную установку Zenith рядом с z2r_autobench.
# ZAPRET_CONFIG_PATH=/opt/zapret2/config
# ZENITH_SANDBOX_DIR=/opt/z2r_autobench/Zenith/sandbox

# Локальный HTTP для Zenith orchestrator/voice_tester.py (POST /probe) --
# не выставлять наружу, только 127.0.0.1.
# ZENITH_PROBE_HOST=127.0.0.1
# ZENITH_PROBE_PORT=8765
