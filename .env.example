# Токен Discord-бота (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_bot_token_here

# ID сервера (гильдии), на котором работает бот
GUILD_ID=123456789012345678

# ID голосового канала для тестов (создай канал сам в Discord,
# включи Developer Mode -> ПКМ по каналу -> Copy Channel ID)
TEST_VOICE_CHANNEL_ID=123456789012345678

# Твой Discord user ID — сюда бот будет слать ЛС с результатами
# (ПКМ по своему нику -> Copy User ID)
OWNER_USER_ID=123456789012345678

# Путь к файлу со списком стратегий
STRATEGIES_FILE=config/strategies.yaml

# Сколько секунд держать голосовое соединение перед тем как считать
# подключение успешным (проверяем что не отвалилось)
HOLD_SECONDS=5

# Таймаут на сам connect() к голосовому каналу
CONNECT_TIMEOUT=15

# Пауза между стратегиями в /voice_test_all, секунды
STRATEGY_SWITCH_DELAY=5
